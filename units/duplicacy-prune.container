[Unit]
Description=Duplicacy Prune
OnSuccess=email-unit-invocation-logs@%n.service
OnFailure=email-unit-invocation-logs@%n.service

[Container]
Image=ghcr.io/computator/duplicacy
Network=none

Volume=duplicacy-prune:/repo
Volume=/srv/media/files/duplicacy:/data
Secret=duplicacy-key,type=env,target=DUPLICACY_PASSWORD

Exec=-log prune \
	-all \
	-threads 4 \
	-keep 180:360 \
	-keep 30:120 \
	-keep 14:60 \
	-keep 7:14
